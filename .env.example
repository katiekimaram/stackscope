# Set in your shell or host. Node does not automatically load this file.
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
STACKSCOPE_DATABASE=stackscope.sqlite
# Production requires a stable random secret of at least 32 characters.
DEVICE_HASH_SECRET=
ADMIN_USERNAMES=
REGISTRATIONS_PER_NETWORK_PER_DAY=3
# Configure Stripe in TEST mode before launch:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Electron: HTTP only for loopback. Use HTTPS for remote services.
STACKSCOPE_SERVICE_URL=http://127.0.0.1:8787
